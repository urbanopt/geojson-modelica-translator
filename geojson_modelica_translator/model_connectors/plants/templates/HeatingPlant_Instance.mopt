{#-
  Heating-plant instance template.

  PATCH (2026-05-20): mHW_flow_nominal, mBoi_flow_nominal, Q_flow_nominal,
  QBoi_flow_nominal, mMin_flow, dpBoi_nominal and the HHW pump performance
  curve are now driven by
  sys_params.district_system.fourth_generation.central_heating_plant_parameters
  instead of being hard-coded inside the template. See
  docs/sizing_district_systems.md for how to size these.

  Conventions used here (mirroring CoolingPlant_Instance.mopt):
    * `heat_flow_nominal`         is the *total plant* heating capacity (W).
    * `mass_hhw_flow_nominal`     is the *total plant* heating-water flow (kg/s).
    * `boiler_water_flow_minimum` is the *total plant* minimum flow (kg/s);
      the template divides by numBoi to get each boiler's mMin_flow.
    * `pressure_drop_hhw_nominal` is the boiler-side ΔP (Pa).
    * `temp_setpoint_hhw` is already wired into the plant via the
      network↔plant coupling templates and does not appear here.

  Still TODO (out of scope here, see docs/sizing_district_systems.md):
    * `numBoi` is still hard-coded inside CentralHeatingPlant.mo (default = 2).
      Wire it through sys_params (parallel to `num_chillers`).
    * `delT_nominal` (15 K) and the +50 000 Pa pumDP safety margin are still
      hard-coded below; consider exposing them as sys_params fields.
    * The boiler model record itself is hard-coded inside CentralHeatingPlant.mo.
-#}
  // heating plant instance
  parameter Modelica.Units.SI.HeatFlowRate Q_flow_nominal_{{ model.id }}={{ sys_params.district_system.fourth_generation.central_heating_plant_parameters.heat_flow_nominal }}
    "Total district heating load (sys_params: heat_flow_nominal)";
  parameter Modelica.Units.SI.Power QBoi_nominal_{{ model.id }}=Q_flow_nominal_{{ model.id }}/{{ model.id }}.numBoi
    "Nominal heating capacity per boiler (Q_flow_nominal divided by numBoi)";
  parameter Modelica.Units.SI.MassFlowRate mHW_flow_nominal_{{ model.id }}={{ sys_params.district_system.fourth_generation.central_heating_plant_parameters.mass_hhw_flow_nominal }}
    "Total plant heating-water mass flow rate (sys_params: mass_hhw_flow_nominal)";
  parameter Modelica.Units.SI.MassFlowRate mBoi_flow_nominal_{{ model.id }}=mHW_flow_nominal_{{ model.id }}/{{ model.id }}.numBoi
    "Per-boiler nominal heating-water mass flow rate (mHW_flow_nominal / numBoi)";
  parameter Modelica.Units.SI.MassFlowRate mMin_flow_{{ model.id }}={{ sys_params.district_system.fourth_generation.central_heating_plant_parameters.boiler_water_flow_minimum }}/{{ model.id }}.numBoi
    "Minimum mass flow rate per boiler (sys_params: boiler_water_flow_minimum divided by numBoi)";
  parameter Modelica.Units.SI.Pressure dpBoi_nominal_{{ model.id }}={{ sys_params.district_system.fourth_generation.central_heating_plant_parameters.pressure_drop_hhw_nominal }}
    "Nominal boiler-side pressure drop (sys_params: pressure_drop_hhw_nominal)";
  // controls
  parameter Modelica.Units.SI.Pressure pumDP_{{ model.id }}=dpBoi_nominal_{{ model.id }}+dpSetPoi_{{ couplings.network_couplings[0].network.id }}+50000
    "Heating water pump pressure drop";
  parameter Modelica.Units.SI.Time tWai_{{ model.id }}=30
    "Waiting time";
  parameter Buildings.Fluid.Movers.Data.Generic perHWPum_{{ model.id }}(
    pressure=Buildings.Fluid.Movers.BaseClasses.Characteristics.flowParameters(
      V_flow=mBoi_flow_nominal_{{ model.id }}/1000*{0.1,1.1},
      dp=pumDP_{{ model.id }}*{1.1,0.1}))
    "Performance data for heating water pumps";

  {{ model.modelica_type }} {{ model.id }}(
    perHWPum=perHWPum_{{ model.id }},
    mHW_flow_nominal=mHW_flow_nominal_{{ model.id }},
    QBoi_flow_nominal=QBoi_nominal_{{ model.id }},
    mMin_flow=mMin_flow_{{ model.id }},
    mBoi_flow_nominal=mBoi_flow_nominal_{{ model.id }},
    dpBoi_nominal=dpBoi_nominal_{{ model.id }},
    delT_nominal(
      displayUnit="degC")=15,
    tWai=tWai_{{ model.id }},
    // TODO: we're currently grabbing dpSetPoi from the Network instance -- need feedback to determine if that's the proper "home" for it
    dpSetPoi=dpSetPoi_{{ couplings.network_couplings[0].network.id }}
    )
    "District heating plant."
    annotation (Placement({{ diagram.transformation.heating_plant.plant }}));
annotation (
revisions="<html>
<ul>
<li>
May 20, 2026, by Nicholas Long:<br/>
Sys_params keys heat_flow_nominal, mass_hhw_flow_nominal,
boiler_water_flow_minimum, and pressure_drop_hhw_nominal now propagate into
the generated heating plant Modelica (previously hard-coded inside the
template; e.g. Q_flow_nominal=1000000*2). The HHW pump performance curve also
now reflects the plant flow and head. Within GMT, see
docs/sizing_district_systems.md for sizing guidance.
</li>
</ul>
</html>");
