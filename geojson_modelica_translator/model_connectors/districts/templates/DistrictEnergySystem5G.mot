within {{ district_within_path }};
model DistrictEnergySystem
  extends Modelica.Icons.Example;
  // District Parameters
{% if fluid.fluid_name == "Water" %}
  package MediumW=Buildings.Media.Water
{% elif fluid.fluid_name == "PropyleneGlycol" %}
  package MediumW=Buildings.Media.Antifreeze.PropyleneGlycolWater(
    property_T={{fluid.temperature + 273.15}},
    X_a={{fluid.concentration_percent}})
{% elif fluid.fluid_name == "EthyleneGlycol" %}
  replaceable package MediumW=Buildings.Media.Antifreeze.EthyleneGlycolWater(
    property_T={{fluid.temperature + 273.15}},
    X_a={{fluid.concentration_percent}})
{% elif fluid.fluid_name == "EthylAlcohol" %}
  replaceable package MediumW=Buildings.Media.Antifreeze.EthylAlcoholWater(
    property_T={{fluid.temperature + 273.15}},
    X_a={{fluid.concentration_percent}})
{% elif fluid.fluid_name == "MethylAlcohol" %}
  replaceable package MediumW=Buildings.Media.Antifreeze.MethylAlcoholWater(
    property_T={{fluid.temperature + 273.15}},
    X_a={{fluid.concentration_percent}})
{% else %}
  replaceable package MediumW=Buildings.Media.Water
{% endif %}{% raw %}
    "Source side medium";
{% endraw %}
  // Models
  {% for model in models %}
  //
  // Begin Model Instance for {{ model.id }}
  // Source template: {{ model.instance_template_path }}
  //
  {{ model.instance }}
  //
  // End Model Instance for {{ model.id }}
  //
  {% endfor %} // Model dependencies
  {% for coupling in couplings %}
  //
  // Begin Component Definitions for {{ coupling.id }}
  // Source template: {{ coupling.coupling_definitions_template_path }}
  //
  {{ coupling.component_definitions }}
  //
// End Component Definitions for {{ coupling.id }}
//
{% endfor %} equation
// Connections
{% for coupling in couplings %}
//
// Begin Connect Statements for {{ coupling.id }}
// Source template: {{ coupling.connect_statements_template_path }}
//
{{ coupling.connect_statements }}
//
// End Connect Statements for {{ coupling.id }}
//
{% endfor %} annotation (
  experiment(
    StopTime=86400,
    Interval=3600,
    Tolerance=1e-04),
  Diagram(
    coordinateSystem(
      preserveAspectRatio=false,
      extent={{ diagram.extent }})),
  Documentation(
    revisions="<html>
 <li>
 July 11, 2026, by Nicholas Long:<br/>
 Performance: relaxed the solver Tolerance in the experiment annotation from
 <code>1e-6</code> to <code>1e-4</code>. For the 5G DES models runtime is
 dominated by the Jacobian/nonlinear-system evaluation, and a <code>1e-4</code>
 tolerance runs roughly 15x faster than <code>1e-6</code> while changing energy
 KPIs by &lt;0.02%. Mirrors the same change in the GMT_Lib DHC_5G templates.
</li>
 <li>
 May 10, 2020: Hagar Elarga<br/>
Updated implementation to handle template needed for GeoJSON to Modelica.
</li>
</html>"));
end DistrictEnergySystem;
